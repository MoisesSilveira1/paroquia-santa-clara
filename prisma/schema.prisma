// Modelo de dados do site da paróquia.
//
// Os campos de situação (status, categoria, papel) são texto, e não `enum`.
// Vêm da época do SQLite, que não tem enum; os valores válidos são definidos e
// checados em lib/validacao/esquemas.ts. Agora no Postgres eles poderiam virar
// enums de verdade — fica como melhoria futura, porque exigiria uma migração
// de tipo em cada coluna sem trazer ganho imediato para as telas.

generator client {
  provider = "prisma-client"
  output   = "../lib/gerado/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Acesso ao painel
// ---------------------------------------------------------------------------

model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  /// Nunca guarda a senha em si — ver lib/auth/senha.ts.
  senhaHash    String
  /// "COORDENADOR" | "ADMIN_COMUM" | "PADRE" | "SUPER_ADMIN" — quem pode o
  /// quê está em lib/auth/papeis.ts. O padrão é o mais restrito de propósito:
  /// um cadastro que chegue sem papel definido não deve nascer podendo tudo.
  papel        String   @default("ADMIN_COMUM")
  /// Desligar o acesso sem apagar o histórico de quem publicou o quê.
  ativo        Boolean  @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sessoes  Sessao[]
  noticias Noticia[]
  /// As pastorais que esta conta coordena — ver `Coordenador.usuario`.
  coordena Coordenador[]

  @@map("usuarios")
}

model Sessao {
  id        String   @id @default(cuid())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  /// Guarda o resumo do token, não o token: quem lê o banco não consegue
  /// se passar por ninguém.
  tokenHash String   @unique
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([usuarioId])
  @@map("sessoes")
}

/// Contagem de erros na tela de entrada, para frear quem tenta adivinhar senha.
///
/// Fica no banco, e não na memória do servidor, porque em hospedagem
/// serverless cada requisição pode cair numa cópia diferente do servidor — uma
/// contagem na memória seria zerada o tempo todo. Ver lib/auth/tentativas.ts.
///
/// A `chave` é um resumo de e-mail + endereço de rede: o banco não guarda nem
/// um nem outro em claro, e as linhas são apagadas 15 minutos depois.
model TentativaDeEntrada {
  id       String   @id @default(cuid())
  chave    String
  criadoEm DateTime @default(now())

  @@index([chave, criadoEm])
  @@map("tentativas_de_entrada")
}

// ---------------------------------------------------------------------------
// Conteúdo publicado
// ---------------------------------------------------------------------------

/// Recados curtos da secretaria, exibidos na página inicial.
model Aviso {
  id           String   @id @default(cuid())
  texto        String
  ativo        Boolean  @default(true)
  /// Menor aparece primeiro.
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, ordem])
  @@map("avisos")
}

/// O aviso que abre o site: aparece numa janela sobre a página inicial e
/// precisa ser fechado para continuar navegando.
///
/// É outra coisa do `Aviso` acima. Aquele é o recado curto de todo domingo,
/// vários ao mesmo tempo, em lista na página inicial. Este é o comunicado que
/// a paróquia quer que ninguém deixe de ver — só um no ar de cada vez, com
/// imagem e vídeo.
model AvisoParoquial {
  id     String  @id @default(cuid())
  titulo String
  texto  String?
  /// Endereço de um vídeo do YouTube, como a pessoa copiou do navegador.
  /// O identificador é extraído na hora de montar a página; guardar a URL
  /// inteira deixa a secretaria conferir depois o que ela colou.
  videoUrl String?

  /// Só um aviso fica ativo por vez — ver `publicarAviso` no serviço.
  ativo Boolean @default(false)
  /// Depois desta data o aviso some sozinho. Sem isto, um comunicado esquecido
  /// bloquearia a entrada do site para sempre.
  expiraEm DateTime?

  imagem ImagemDeAviso?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, atualizadoEm])
  @@map("avisos_paroquiais")
}

/// Os bytes da imagem de um aviso paroquial.
///
/// Tabela separada de `Imagem` (a da galeria) de propósito: lá a dona é uma
/// foto de álbum, aqui é um aviso, e cada uma apaga a sua em cascata. Juntar
/// as duas exigiria uma coluna de dono opcional e a regra "exatamente uma
/// preenchida", que ninguém garante — duas tabelas pequenas se explicam
/// sozinhas.
model ImagemDeAviso {
  id      String         @id @default(cuid())
  aviso   AvisoParoquial @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  avisoId String         @unique

  dados   Bytes
  tipo    String
  largura Int
  altura  Int
  bytes   Int

  criadoEm DateTime @default(now())

  @@map("imagens_de_avisos")
}

model Noticia {
  id     String @id @default(cuid())
  /// Endereço da notícia no site (/noticias/festa-de-santa-clara-2026).
  slug   String @unique
  titulo String
  resumo String
  corpo  String?
  /// "NOTICIA" | "EVENTO"
  categoria String @default("NOTICIA")
  /// "RASCUNHO" | "PUBLICADA" | "ARQUIVADA"
  status    String @default("RASCUNHO")
  destaque  Boolean @default(false)
  /// Data em que passou a valer no site. Fica nula enquanto é rascunho.
  publicadaEm DateTime?

  autor   Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorId String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, publicadaEm])
  @@index([autorId])
  @@map("noticias")
}

/// Uma linha da grade de horários: missa, confissão, adoração.
model Celebracao {
  id String @id @default(cuid())
  /// 0 = domingo ... 6 = sábado. Número para ordenar sem depender do idioma.
  diaSemana Int
  /// "19:30" — texto porque é hora do calendário, não instante no tempo.
  hora        String
  nome        String
  local       String  @default("Igreja Matriz")
  transmitida Boolean @default(false)
  observacao  String?
  ativo       Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativo, diaSemana, hora])
  @@map("celebracoes")
}

model Pastoral {
  id        String  @id @default(cuid())
  slug      String  @unique
  nome      String
  descricao String
  contato   String
  reunioes  String
  ativa     Boolean @default(true)
  ordem     Int     @default(0)

  coordenadores Coordenador[]
  eventos       EventoDaPastoral[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ativa, ordem])
  @@map("pastorais")
}

/// Quem serve numa pastoral ou movimento: a coordenação e a equipe.
///
/// O modelo se chama `Coordenador` porque nasceu assim, guardando só a
/// coordenação; no mesmo dia passou a guardar a equipe inteira, separada pelo
/// campo `naCoordenacao`. Renomear arrastaria a tabela, o serviço, duas telas
/// e o nome da permissão sem mudar nada para quem usa o site — fica anotado
/// aqui para ninguém se enganar lendo só o nome do modelo.
///
/// Fica separado de `Pastoral` porque a equipe troca de gente e a pastoral em
/// si continua a mesma. O campo `contato` da pastoral segue existindo para o
/// telefone institucional — o da secretaria, o da sala.
///
/// Coordenar não dá acesso ao painel por si só: o acesso vem do `usuarioId`,
/// que a secretaria preenche quando a pessoa recebe uma conta. A maior parte
/// da equipe fica sem conta nenhuma, e é assim que deve ser.
model Coordenador {
  id   String @id @default(cuid())
  nome String
  /// "Coordenador(a)", "Vice-coordenador(a)", "Secretário(a)"...
  funcao String @default("Coordenador(a)")

  telefone String?
  email    String?
  /// Se o telefone e o e-mail podem aparecer no site.
  ///
  /// Nasce desligado de propósito. Coordenador é voluntário da comunidade, e
  /// publicar o telefone de alguém sem que a pessoa tenha dito "pode" é
  /// diferente de publicar o número da secretaria. O nome e a função aparecem
  /// sempre; o contato, só com autorização.
  contatoPublico Boolean @default(false)

  pastoral   Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)
  pastoralId String

  /// A conta do painel desta pessoa, quando ela tem uma.
  ///
  /// É este vínculo que diz "fulano coordena a Liturgia": um usuário de papel
  /// COORDENADOR só enxerga e edita as pastorais em que aparece aqui, com
  /// `naCoordenacao` marcado. Sem o vínculo, a conta entra no painel e não
  /// alcança nada — de propósito, porque a alternativa seria alcançar tudo.
  ///
  /// Fica aqui, e não numa tabela à parte, para não haver duas respostas para
  /// "quem coordena a Liturgia": a pessoa já está na equipe, e a conta é só
  /// mais um dado dela.
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId String?

  /// Coordenação (coordenador, vice, secretário) ou equipe (os demais).
  ///
  /// A página da pastoral mostra os dois grupos separados, porque é assim que
  /// a comunidade os enxerga: quem procura "com quem falo" quer a coordenação,
  /// e quem quer saber "quem serve aqui" quer a equipe inteira.
  naCoordenacao Boolean @default(true)

  ativo Boolean @default(true)
  /// Menor aparece primeiro — serve para o coordenador vir antes do vice.
  ordem Int     @default(0)

  escalas EscalaNoEvento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([pastoralId, ordem])
  @@index([ativo])
  @@index([usuarioId])
  @@map("coordenadores")
}

/// Um compromisso da agenda de uma pastoral: reunião ou escala de serviço.
///
/// A agenda pertence ao grupo, e não à paróquia inteira: cada coordenador vê
/// e marca a sua. É por isso que o `pastoralId` é obrigatório e apaga em
/// cascata — agenda sem dono não teria quem cuidasse dela.
model EventoDaPastoral {
  id         String   @id @default(cuid())
  pastoral   Pastoral @relation(fields: [pastoralId], references: [id], onDelete: Cascade)
  pastoralId String

  titulo String
  /// "REUNIAO" | "ESCALA" — ver lib/validacao/esquemas.ts.
  ///
  /// Separados porque são coisas diferentes na vida do grupo: a reunião é do
  /// grupo todo, a escala diz quem serve naquele dia. A tela mostra cada uma
  /// com sua cara.
  tipo String @default("REUNIAO")

  /// Início do compromisso. Guardado como instante, e não como texto, para o
  /// calendário conseguir ordenar e agrupar por dia.
  inicio DateTime
  /// Fim, quando faz diferença. Reunião de uma hora costuma não precisar.
  fim    DateTime?

  /// Onde: "Salão paroquial", "Sala 2", "Quiosque". Texto livre por enquanto —
  /// a lista fechada de espaços, com aviso de choque de horário, depende de a
  /// paróquia dizer quais espaços existem.
  local      String?
  observacao String?

  escalados EscalaNoEvento[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([pastoralId, inicio])
  @@map("eventos_de_pastoral")
}

/// Quem está escalado para servir num evento.
model EscalaNoEvento {
  id       String           @id @default(cuid())
  evento   EventoDaPastoral @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  eventoId String
  /// A pessoa vem da equipe da pastoral: escalar quem não está na equipe seria
  /// escalar um desconhecido.
  membro   Coordenador      @relation(fields: [membroId], references: [id], onDelete: Cascade)
  membroId String

  criadoEm DateTime @default(now())

  @@unique([eventoId, membroId])
  @@index([membroId])
  @@map("escalas_de_evento")
}

model Album {
  id        String    @id @default(cuid())
  titulo    String
  /// Data do evento retratado, não a do envio das fotos.
  data      DateTime?
  publicado Boolean   @default(false)

  fotos Foto[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([publicado, data])
  @@map("albuns")
}

model Foto {
  id      String @id @default(cuid())
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  albumId String
  /// Caminho pronto para o `src` da imagem: `/imagens/<id>` quando a foto foi
  /// enviada pelo painel, ou um arquivo de `/public` para as fotos que vieram
  /// junto com o código.
  url     String
  legenda String?
  ordem   Int    @default(0)

  criadoEm DateTime @default(now())

  imagem Imagem?

  @@index([albumId, ordem])
  @@map("fotos")
}

/// Os bytes de uma foto enviada pelo painel.
///
/// Fica numa tabela separada de propósito: as listagens da galeria leem
/// `fotos` o tempo todo, e um `Bytes` ali dentro viria junto em qualquer
/// consulta distraída que esquecesse o `select`.
///
/// Guardar a imagem no banco (em vez de gravar um arquivo em `public/`) é o
/// que faz o envio funcionar depois de publicado: em hospedagem serverless o
/// disco é descartado a cada implantação, então um arquivo gravado ali some.
/// Assim o banco continua sendo o único lugar que precisa de backup.
model Imagem {
  id     String @id @default(cuid())
  /// A foto é a dona: apagar a foto (ou o álbum inteiro) leva os bytes junto.
  foto   Foto   @relation(fields: [fotoId], references: [id], onDelete: Cascade)
  fotoId String @unique

  dados   Bytes
  /// Tipo MIME servido no cabeçalho, sempre `image/webp` hoje.
  tipo    String
  largura Int
  altura  Int
  bytes   Int

  criadoEm DateTime @default(now())

  @@map("imagens")
}

// ---------------------------------------------------------------------------
// Catequese
// ---------------------------------------------------------------------------

/// Como a catequese está funcionando neste momento.
///
/// É uma tabela de uma linha só (`id` fixo em "unica"). Parece estranho, mas a
/// alternativa seria um arquivo de configuração no código — e aí a coordenação
/// da catequese dependeria de um programador para abrir as inscrições, que é
/// exatamente o que este painel existe para evitar.
///
/// `inscricoesAbertas` é o interruptor que a comunidade sente: fechado, o
/// formulário de inscrição some do site e a rota recusa envio. As duas coisas,
/// e não só a primeira — esconder o botão não fecha a porta.
model ConfiguracaoDaCatequese {
  id String @id @default("unica")

  /// Enquanto falso, ninguém se inscreve pelo site.
  inscricoesAbertas Boolean @default(false)
  /// "2027" — aparece no formulário e marca cada inscrição recebida.
  anoLetivo         String
  /// Texto livre da coordenação: prazo, documentos, onde entregar.
  /// Aparece na página da catequese, aberto ou fechado o período.
  aviso             String?

  atualizadoEm DateTime @updatedAt

  @@map("configuracao_da_catequese")
}

/// Uma turma da catequese: dia, hora, lugar e quem ensina.
///
/// A etapa é texto livre de propósito. Cada paróquia nomeia as suas de um
/// jeito — "Eucaristia I", "IVC 2", "Crisma Jovens" — e engessar isso numa
/// lista fechada no código obrigaria a mexer no sistema para acompanhar a
/// caminhada da comunidade. Quem nomeia é a coordenação da catequese.
model TurmaDeCatequese {
  id   String @id @default(cuid())
  nome String
  /// "Eucaristia I", "Crisma", "Catequese de adultos"...
  etapa String

  /// 0 = domingo ... 6 = sábado. Número para ordenar sem depender do idioma.
  diaSemana Int
  /// "09:00" — hora do calendário, não instante no tempo.
  hora      String
  /// Um dos espaços de lib/paroquia/espacos.ts, mas sem lista fechada.
  local     String?

  /// Quantas crianças cabem. Zero = sem limite declarado.
  ///
  /// Não bloqueia a inscrição: quem decide se abre exceção é a coordenação,
  /// olhando caso a caso. O número serve para o painel avisar que a turma
  /// encheu, e para o site não oferecer o que não tem.
  vagas Int @default(0)

  /// Nomes de quem dá a turma, como a coordenação quer que apareça.
  /// Texto, e não ligação com `Coordenador`, porque catequista nem sempre está
  /// cadastrado na equipe — e obrigar o cadastro travaria a abertura da turma.
  catequistas String?

  anoLetivo String
  ativa     Boolean @default(true)
  ordem     Int     @default(0)

  inscricoes InscricaoNaCatequese[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([anoLetivo, ativa, ordem])
  @@map("turmas_de_catequese")
}

/// Um pedido de inscrição feito pelo site.
///
/// ATENÇÃO — esta tabela guarda DADO PESSOAL DE CRIANÇA: nome, data de
/// nascimento e o telefone de quem responde por ela. Isso tem três
/// consequências que valem para qualquer código que a toque:
///
///   1. Nada daqui vai para o site. Não há consulta pública a esta tabela, e
///      não deve haver. Quem lê é a coordenação da catequese e a secretaria.
///   2. O envio exige consentimento explícito de quem preenche
///      (`consentimentoEm`), guardado com a data. Sem ele o formulário não
///      passa — ver lib/validacao/esquemas.ts.
///   3. Inscrição é papel de um ano. Passado o ano letivo, não há motivo para
///      guardar — ver docs/privacidade.md.
///
/// É um PEDIDO, não uma matrícula: quem confirma é a coordenação, depois de
/// conferir documento e conversar com a família. Por isso o `status` nasce
/// como "RECEBIDA" e a turma escolhida é apenas a preferida.
model InscricaoNaCatequese {
  id String @id @default(cuid())

  /// "NOVA" | "RENOVACAO" — ver lib/validacao/esquemas.ts.
  tipo String @default("NOVA")
  /// "RECEBIDA" | "EM_ANALISE" | "CONFIRMADA" | "RECUSADA"
  status String @default("RECEBIDA")

  /// A turma que a família prefere. Fica nula se a turma for apagada: o
  /// pedido continua valendo, só perde a preferência.
  turma   TurmaDeCatequese? @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  turmaId String?

  // ----- quem vai ser catequizado -----
  nome            String
  dataNascimento  DateTime
  /// Se já foi batizado, e onde. A catequese precisa saber para encaminhar
  /// quem ainda não foi.
  batizado        Boolean @default(false)
  paroquiaBatismo String?

  // ----- quem responde por ele -----
  responsavel  String
  /// "Mãe", "Pai", "Avó", "O próprio" (adulto se inscrevendo).
  parentesco   String
  telefone     String
  email        String?

  /// Padrinho e madrinha, quando a etapa pede (Crisma).
  padrinho String?

  observacao String?

  anoLetivo String

  /// Quando a pessoa marcou o aceite de uso dos dados. Guardar a data, e não
  /// só "sim", é o que permite provar depois QUANDO o consentimento foi dado.
  consentimentoEm DateTime

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([anoLetivo, status, criadoEm])
  @@index([turmaId])
  @@map("inscricoes_na_catequese")
}

// ---------------------------------------------------------------------------
// Recebido do site
// ---------------------------------------------------------------------------

/// Mensagem enviada pelo formulário de contato.
model Mensagem {
  id       String  @id @default(cuid())
  nome     String
  email    String
  telefone String?
  assunto  String
  corpo    String
  /// "NOVA" | "LIDA" | "RESPONDIDA" | "ARQUIVADA"
  status   String  @default("NOVA")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status, criadoEm])
  @@map("mensagens")
}
