# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# O exemplo e documentacao, nao segredo: o README aponta para ele.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# Cliente gerado a partir do schema: recriado por `npm run db:gerar`.
/lib/gerado/prisma
# Banco local de desenvolvimento — cada máquina tem o seu, populado pelo seed.
/prisma/*.db
/prisma/*.db-journal
/prisma/*.db-wal
/prisma/*.db-shm

# Skills de referência do Prisma (docs da v7 lidas por assistentes de código).
# A cópia versionada é a de .claude/skills; .agents é a mesma coisa duplicada
# pelo `prisma init` para outras ferramentas.
/.agents
